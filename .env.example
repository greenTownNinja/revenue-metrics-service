# HTTP port. Render injects this automatically in production.
PORT=3000

# Supabase Postgres. MUST be the connection POOLER string, not the direct db.<ref>.supabase.co
# host — Render's free tier cannot reliably reach the direct host over IPv6.
# Looks like: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Stripe TEST-mode secret key. Never a live key, and never a real value in this
# file — .env.example is committed. Put the real key in .env, which is ignored.
STRIPE_SECRET_KEY=sk_test_...

# PayPal REST app credentials (developer.paypal.com → Apps & Credentials).
# The app must have the "Transaction Search" feature enabled, or the reporting
# endpoint returns 403.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 'sandbox' (default) or 'live'. Live requires an explicit opt-in.
PAYPAL_ENV=sandbox
# How far back a first sync looks, before a watermark exists.
PAYPAL_LOOKBACK_DAYS=31

# The CSV ledger is a fixture, not a real source. Off unless explicitly enabled;
# `npm run demo` turns it on for itself.
ENABLE_CSV_SOURCE=false

LOG_LEVEL=info
NODE_ENV=development
